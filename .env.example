# LoopProof environment template — PLACEHOLDERS ONLY.
# Copy to `.env` locally (never commit `.env`). Hardhat 3 reads these via
# `configVariable(...)` from process.env or from the encrypted Hardhat keystore
# (`npx hardhat keystore set <NAME>`), which is the preferred option for keys.
#
# Not needed for Milestone 0 or local tests. Testnet deployment is out of scope
# until explicitly approved.

# Primary testnet: Base Sepolia (see docs/DECISIONS.md)
BASE_SEPOLIA_RPC_URL=<your-base-sepolia-rpc-url>
BASE_SEPOLIA_PRIVATE_KEY=<testnet-only-private-key-never-real-funds>

# Fallback testnet: Polygon Amoy (only if Base Sepolia fails verification)
POLYGON_AMOY_RPC_URL=<your-polygon-amoy-rpc-url>
POLYGON_AMOY_PRIVATE_KEY=<testnet-only-private-key-never-real-funds>

# LoopProof Web — Supabase Environment Variables (PLACEHOLDERS ONLY)
# Copy this file to `web/.env.local` for local development.
# `.env.local` is gitignored and must NEVER be committed.
#
# SECURITY:
# - Only the public URL and publishable (anon) key belong here.
# - NEVER put `SUPABASE_SERVICE_ROLE_KEY` or database passwords in `.env.local`
#   or any `NEXT_PUBLIC_*` variable. Row Level Security (RLS) and `auth.uid()`
#   enforce all access control through the user's authenticated session.

NEXT_PUBLIC_SUPABASE_URL=https://tvsjrxjvmebbofjdzxnm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-or-anon-key>
